# --- Database (Supabase) -----------------------------------------------------
# Use the SESSION-mode pooler host (port 5432), not the transaction pooler (6543):
# Prisma takes a session-scoped advisory lock that transaction pooling breaks.
# Also avoid db.<ref>.supabase.co — it resolves IPv6-only on newer projects.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Used by the Prisma CLI (db push / migrate). Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
JWT_SECRET="change-me-to-at-least-16-characters"
JWT_EXPIRES_IN="12h"

# --- Seed admin --------------------------------------------------------------
SEED_ADMIN_EMAIL="operations@innovoxpress.com"
SEED_ADMIN_PASSWORD="ChangeMe!123"
SEED_ADMIN_NAME="Operations"

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"
